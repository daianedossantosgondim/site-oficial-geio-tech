{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=@geio/institucional",
  "outputDirectory": "apps/institucional/.next",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/obrigado.html", "destination": "/", "permanent": true }
  ]
}
