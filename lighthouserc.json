{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start --workspace=@geio/institucional",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/diagnostico-preliminar-parametrico",
        "http://localhost:3100/metodologia",
        "http://localhost:3100/transparencia"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.98 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 1.0 }],
        "categories:seo": ["error", { "minScore": 1.0 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 1200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0 }],
        "total-blocking-time": ["error", { "maxNumericValue": 100 }],

        "unused-javascript": ["warn", { "maxLength": 0 }],
        "uses-text-compression": "error",
        "uses-responsive-images": "error",
        "color-contrast": "error",
        "heading-order": "error",
        "html-has-lang": "error",
        "meta-description": "error",
        "document-title": "error",
        "link-name": "error",
        "label": "error",
        "aria-valid-attr-value": "error",
        "aria-required-attr": "error"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
